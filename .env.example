# Copy this file to .env and fill in real values. .env is gitignored.
#
# EXPO_PUBLIC_-prefixed vars are bundled into the client app - only put
# values here that are safe to ship inside the app (the Supabase anon/
# publishable key is safe by design; RLS is what actually protects data,
# not keeping this key secret). NEVER put the service_role key in this
# file or anywhere the mobile app reads from.

# Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
