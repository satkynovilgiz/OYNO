{
  "expo": {
    "name": "OYNO",
    "slug": "oyno",
    "scheme": "oyno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ilgizsatkynov.oyno",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ilgizsatkynov.oyno",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-localization",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "OYNO админ панелине сүрөт жүктөө үчүн сүрөт китепканаңызга кирүү керек."
        }
      ],
      "expo-asset",
      "expo-screen-orientation",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bad293a4-8544-4fb6-8b5f-776a51bd4f7b"
      }
    },
    "owner": "ilgizsatkynov",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bad293a4-8544-4fb6-8b5f-776a51bd4f7b"
    }
  }
}
