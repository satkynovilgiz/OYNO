{
  "expo": {
    "name": "OYNO",
    "slug": "oyno",
    "scheme": "oyno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ilgizsatkynov.oyno",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.ilgizsatkynov.oyno.widgets"
        ]
      }
    },
    "android": {
      "package": "com.ilgizsatkynov.oyno",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-localization",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "OYNO opens your photo library only when you choose a photo to upload."
        }
      ],
      "expo-asset",
      "expo-screen-orientation",
      "expo-dev-client",
      "@sentry/react-native",
      "expo-image",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "OYNO opens your photo library only when you choose a photo to upload.",
          "savePhotosPermission": "OYNO saves the wallpapers you choose to your Photos, so you can set them as your wallpaper.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bad293a4-8544-4fb6-8b5f-776a51bd4f7b"
      }
    },
    "owner": "ilgizsatkynov",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bad293a4-8544-4fb6-8b5f-776a51bd4f7b"
    },
    "locales": {
      "en": "./locales/en.json",
      "ky": "./locales/ky.json",
      "ru": "./locales/ru.json"
    }
  }
}
